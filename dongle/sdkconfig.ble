# Overlay: the dongle talks to the vault over BLE (NimBLE). Use together with the other files, e.g.
#   -D "SDKCONFIG_DEFAULTS=sdkconfig.defaults;sdkconfig.hid;sdkconfig.ble"
CONFIG_DONGLE_TRANSPORT_BLE=y

CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
# INFO level prints two lines per packet and slows the host task
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
