# KeyKeeper2 dongle (Waveshare ESP32-S3-LCD-1.47B). Same board settings as the vault firmware.

CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000

# External PSRAM (as in the vault firmware)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_USE_MALLOC=y

# One app partition, 1.5 MB (LVGL + the display driver do not fit the 1 MB default comfortably).
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# Log over the board's USB port (native "USB Serial/JTAG"), not over UART0 on GPIO43/44.
# (When the dongle later acts as a USB keyboard it will own that port; logs then move to UART0.)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# X25519 and the PSA calls need more stack than the 3.5 KB default.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# LVGL: fonts used by the screen, and the compressed-font decoder the display component's fonts need.
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_USE_FONT_COMPRESSED=y

# The protocol library (off by default in the vault firmware) and what it needs from mbedTLS.
CONFIG_KEYKEEPER_KKPROTO=y
CONFIG_MBEDTLS_ECP_DP_CURVE25519_ENABLED=y
CONFIG_MBEDTLS_CHACHA20_C=y
CONFIG_MBEDTLS_CHACHAPOLY_C=y
