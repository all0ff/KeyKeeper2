# BLE link test (Waveshare ESP32-S3-LCD-1.47B). Role is chosen by an overlay file, see README.md.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_HZ=1000

# NimBLE only (no Bluedroid, no classic BT)
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y

# Big ATT payload: 247 -> 244 bytes per write/notification
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247

# Quiet the stack: INFO level prints 2 lines per packet and slows the host task
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
