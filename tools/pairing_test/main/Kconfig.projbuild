menu "Pairing test"

    config PAIRING_TEST_UART_NUM
        int "UART controller (1 or 2; 0 is the console)"
        range 1 2
        default 1

    config PAIRING_TEST_TX_PIN
        int "TX GPIO"
        range 0 48
        default 10
        help
            Same pins as the wiring test (tools/uart_link_test): TX of one board goes to RX of the other.

    config PAIRING_TEST_RX_PIN
        int "RX GPIO"
        range 0 48
        default 11

    config PAIRING_TEST_BAUD
        int "Baud rate"
        range 9600 2000000
        default 460800

    config PAIRING_TEST_RETRY_MS
        int "Initiator: restart the handshake after this many ms without progress"
        range 100 10000
        default 1000

    config PAIRING_TEST_MAX_ATTEMPTS
        int "Initiator: give up after this many handshakes"
        range 1 100
        default 8

endmenu
