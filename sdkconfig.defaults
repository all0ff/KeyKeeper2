# ============================================================
# KeyKeeper2 - ESP-IDF default configuration
# Board: Waveshare ESP32-S3-LCD-1.47B
# ============================================================


# ------------------------------------------------------------
# Target
# ------------------------------------------------------------

CONFIG_IDF_TARGET="esp32s3"


# ------------------------------------------------------------
# ESP32-S3 memory
# ------------------------------------------------------------

# External PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y

# Use PSRAM where appropriate for application/runtime buffers
CONFIG_SPIRAM_USE_MALLOC=y


# ------------------------------------------------------------
# Flash
# ------------------------------------------------------------

# Board uses 16 MB Flash
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_TINYUSB_HID_COUNT=1


# ------------------------------------------------------------
# CPU
# ------------------------------------------------------------

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y


# ------------------------------------------------------------
# FreeRTOS
# ------------------------------------------------------------

CONFIG_FREERTOS_HZ=1000


# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------

CONFIG_LOG_DEFAULT_LEVEL_INFO=y


# ------------------------------------------------------------
# Console / UART
# ------------------------------------------------------------

# Keep the ESP-IDF console available during development.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y


# ------------------------------------------------------------
# SPI
# ------------------------------------------------------------

# LCD uses SPI3_HOST.
# GPIO assignment is defined in components/bsp/.
# Do not place LCD GPIO numbers here.


# ------------------------------------------------------------
# LCD / LVGL
# ------------------------------------------------------------

# Display driver configuration is implemented by components/display/.
# ST7789 configuration belongs to the display component/BSP.

# widgets::PinEntry (keyboard.cpp) explicitly uses Montserrat 16/18 --
# neither was previously listed here explicitly (16 apparently came
# from whatever LVGL's own Kconfig defaults enable). Making both
# explicit so the font used in code is never left to an unconfirmed
# default.
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y

# The custom Cyrillic fonts are generated with LVGL bitmap compression
# enabled (lv_font_conv defaults to compression). LVGL must have its
# compressed-font decoder enabled for these fonts to render.
CONFIG_LV_USE_FONT_COMPRESSED=y


# ------------------------------------------------------------
# Partition table
# ------------------------------------------------------------

# Custom table (project root partitions.csv): sized for the board's
# 16 MB flash, adds the "storage" LittleFS partition that vault.db
# lives on. See components/storage/README.md.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"


# ------------------------------------------------------------
# microSD / SDMMC
# ------------------------------------------------------------

# KeyKeeper2 uses the board microSD interface in 4-bit mode.
# (Removed CONFIG_SDMMC_HOST_SUPPORTS_8BIT=y that was here before --
# it was an unrecognized/irrelevant symbol: we use 4-bit, not 8-bit,
# and only 6 SD pins are wired on this board. See
# components/storage/README.md.)


# ------------------------------------------------------------
# Filesystems
# ------------------------------------------------------------

# NVS is used for persistent settings.
CONFIG_NVS_ENCRYPTION=n

# Internal vault storage uses LittleFS (components/storage/), pulled
# in via components/storage/idf_component.yml (joltwallet/littlefs).
# (Removed CONFIG_LITTLEFS=y that was here before -- it was an
# unrecognized symbol that did nothing; there is no such bare toggle.
# See components/storage/README.md.)


# ------------------------------------------------------------
# Watchdog
# ------------------------------------------------------------

CONFIG_ESP_TASK_WDT_EN=y


# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

# Application-specific configuration belongs to components,
# not to sdkconfig.defaults, unless it is an ESP-IDF Kconfig option.
CONFIG_KEYKEEPER_KKPROTO=y
CONFIG_MBEDTLS_ECP_DP_CURVE25519_ENABLED=y
CONFIG_MBEDTLS_CHACHA20_C=y
CONFIG_MBEDTLS_CHACHAPOLY_C=y
CONFIG_WIRELESS_TRANSPORT_BLE=y
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y

# ---- KeyKeeper2: free internal RAM for Wi-Fi + BLE (append this to the END of sdkconfig.defaults) ----

# BLE (repeated here so a fresh sdkconfig keeps it)
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y

# NimBLE host buffers into PSRAM, one connection is enough for the vault
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# Wi-Fi: no code in internal RAM (frees IRAM -> more heap), fewer buffers
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16

# Allocations over 4 KB go to PSRAM (default limit is 16 KB)
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
